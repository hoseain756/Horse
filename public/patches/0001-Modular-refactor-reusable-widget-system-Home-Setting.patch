@@ -0,0 +1,92 @@
+import 'package:flutter/material.dart';
+
+import '../../../core/theme/horse_theme.dart';
+
+/// Shared primitives for the settings feature, extracted verbatim from
+/// settings_page.dart (Task 121-d). Pages adopt these only where their
+/// geometry is pixel-identical; near-miss rows keep their local widgets
+/// (settings_data_page `_DataRow`, settings_preferences_page
+/// `_PreferenceTile`, addons_page `_AddonRow`, the integrations_page
+/// panel cards).
+///
+/// Localization stays caller-owned: strings arrive pre-localized via the
+/// inline `english ? :` convention — no language flag lives here.
+
+/// Gold caption above a group of [SettingsTile]s (padding bottom 9 /
+/// start 3, `titleMedium` tinted [HorseTheme.gold]).
+class SettingsSectionTitle extends StatelessWidget {
+  const SettingsSectionTitle({super.key, required this.title});
+
+  final String title;
+
+  @override
+  Widget build(BuildContext context) => Padding(
+        padding: const EdgeInsetsDirectional.only(bottom: 9, start: 3),
+        child: Text(
+          title,
+          style: Theme.of(
+            context,
+          ).textTheme.titleMedium?.copyWith(color: HorseTheme.gold),
+        ),
+      );
+}
+
+/// Standard tappable settings row: bordered [HorseTheme.surface] card
+/// (radius 15, [HorseTheme.line] border, bottom margin 8) with a 42×42
+/// gold-tinted leading icon box and a default chevron trailing that goes
+/// muted when the tile is not tappable.
+class SettingsTile extends StatelessWidget {
+  const SettingsTile({
+    super.key,
+    required this.icon,
+    required this.title,
+    this.subtitle,
+    this.trailing,
+    this.onTap,
+  });
+
+  final IconData icon;
+  final String title;
+  final String? subtitle;
+  final Widget? trailing;
+  final VoidCallback? onTap;
+
+  @override
+  Widget build(BuildContext context) => Container(
+        margin: const EdgeInsets.only(bottom: 8),
+        child: Material(
+          color: HorseTheme.surface,
+          shape: RoundedRectangleBorder(
+            borderRadius: BorderRadius.circular(15),
+            side: const BorderSide(color: HorseTheme.line),
+          ),
+          clipBehavior: Clip.antiAlias,
+          child: ListTile(
+            onTap: onTap,
+            minVerticalPadding: 12,
+            leading: Container(
+              width: 42,
+              height: 42,
+              decoration: BoxDecoration(
+                color: HorseTheme.gold.withValues(alpha: .10),
+                borderRadius: BorderRadius.circular(HorseTheme.radiusChip),
+              ),
+              child: Icon(icon, color: HorseTheme.gold, size: 21),
+            ),
+            title: Text(title, style: Theme.of(context).textTheme.titleMedium),
+            subtitle: subtitle == null
+                ? null
+                : Padding(
+                    padding: const EdgeInsets.only(top: 4),
+                    child: Text(subtitle!,
+                        style: Theme.of(context).textTheme.bodySmall),
+                  ),
+            trailing: trailing ??
+                Icon(
+                  Icons.chevron_left_rounded,
+                  color: onTap == null ? HorseTheme.muted : HorseTheme.gold,
+                ),
+          ),
+        ),
+      );
+}
diff --git a/lib/shared/widgets/app_state_message.dart b/lib/shared/widgets/app_state_message.dart
new file mode 100644
index 0000000..1a70383
--- /dev/null
+++ b/lib/shared/widgets/app_state_message.dart
@@ -0,0 +1,110 @@
+import 'package:flutter/material.dart';
+
+import '../../core/theme/horse_theme.dart';
+
+/// Shared empty/error/loading state message — the single implementation of
+/// the centered "icon → 12 → message → 14 → action button" column
+/// that existed as 8 near-identical private widgets across features
+/// (evidence: audit 121-a1 + 121-a2 — live_tv `_StateMessage`, catalog
+/// `_Message` + `_GridMessage`, calendar `_CalendarMessage`, anime
+/// `_CatalogState`, home `_RailMessage`/`_ServiceMessage`, detail
+/// `_ErrorView`; the live-tv/catalog/calendar family was pixel-identical
+/// apart from padding 28 vs 24 and icon 44 vs 42).
+///
+/// Visual spec (audit 121-a2 §3): a [Center]ed, non-scrolling column sized
+/// for `Expanded`/`SliverFillRemaining` slots; muted icon (or the standard
+/// gold spinner when [loading]); unstyled centered message text; one action
+/// button — [filledButton] selects `FilledButton` vs `OutlinedButton`, and
+/// [actionIcon] reproduces the page-specific button glyph (live TV's
+/// `Icons.add_rounded`) without altering any existing visual.
+///
+/// Usage rules:
+///  * Strings are pre-localized by the caller (`english ? 'en' : 'ar'`
+///    ternary) — this widget deliberately takes no `english` flag, matching
+///    the MediaRail shared-widget convention.
+///  * The icon always renders [HorseTheme.muted] at [iconSize]; pages whose
+///    state needs a different icon color or gap rhythm (e.g. anime's gold
+///    `_CatalogState`) keep their local widget.
+///  * Pass [iconSize]/[padding] to reproduce the page being migrated
+///    (catalog family: 42 + `EdgeInsets.all(24)`; live-tv/calendar: the
+///    44 + 28 defaults).
+class AppStateMessage extends StatelessWidget {
+  const AppStateMessage({
+    super.key,
+    required this.icon,
+    required this.message,
+    this.actionLabel,
+    this.onAction,
+    this.loading = false,
+    this.filledButton = false,
+    this.actionIcon,
+    this.iconSize = 44,
+    this.padding = const EdgeInsets.all(28),
+  });
+
+  /// State icon (muted) shown unless [loading] is true.
+  final IconData icon;
+
+  /// Pre-localized body line under the icon.
+  final String message;
+
+  /// Pre-localized button label; the button renders only when both this and
+  /// [onAction] are provided.
+  final String? actionLabel;
+  final VoidCallback? onAction;
+
+  /// Swap the icon for the app-standard gold spinner
+  /// (`CircularProgressIndicator(color: HorseTheme.gold, strokeWidth: 2)`).
+  final bool loading;
+
+  /// `true` → `FilledButton`, `false` (default) → `OutlinedButton`.
+  final bool filledButton;
+
+  /// Optional glyph inside the action button (mirrors `XxxButton.icon`).
+  final IconData? actionIcon;
+
+  final double iconSize;
+  final EdgeInsetsGeometry padding;
+
+  @override
+  Widget build(BuildContext context) {
+    return Center(
+      child: Padding(
+        padding: padding,
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            if (loading)
+              const CircularProgressIndicator(
+                color: HorseTheme.gold,
+                strokeWidth: 2,
+              )
+            else
+              Icon(icon, size: iconSize, color: HorseTheme.muted),
+            const SizedBox(height: 12),
+            Text(message, textAlign: TextAlign.center),
+            if (actionLabel != null && onAction != null) ...[
+              const SizedBox(height: 14),
+              if (filledButton && actionIcon != null)
+                FilledButton.icon(
+                  onPressed: onAction,
+                  icon: Icon(actionIcon),
+                  label: Text(actionLabel!),
+                )
+              else if (filledButton)
+                FilledButton(onPressed: onAction, child: Text(actionLabel!))
+              else if (actionIcon != null)
+                OutlinedButton.icon(
+                  onPressed: onAction,
+                  icon: Icon(actionIcon),
+                  label: Text(actionLabel!),
+                )
+              else
+                OutlinedButton(onPressed: onAction, child: Text(actionLabel!)),
+            ],
+          ],
+        ),
+      ),
+    );
+  }
+}
