# Horse — reference for environment variables.
# Local dev: copy to `.env` (gitignored) and adjust.
# Vercel: Project → Settings → Environment Variables (set for Production AND Preview).

# --- Database (durable backend for accounts + sync) ---
# RECOMMENDED: Turso (libSQL) — durable, shared by ALL serverless instances.
#   1. Sign up at turso.com (free, GitHub login works) → Create database
#   2. HORSE_DATABASE_URL = libsql://<db-name>-<org>.turso.io  (copy from the dashboard)
#   3. HORSE_DB_AUTH_TOKEN = a database token (Create token in the dashboard)
#   Tables are created AUTOMATICALLY on the first request (ensure-db.ts).
# Without Turso the fallback below is a per-instance /tmp file: accounts and
# sync survive only while a single server instance stays warm (data loss!).
HORSE_DATABASE_URL="file:/tmp/horse.db"
HORSE_DB_AUTH_TOKEN=

# --- Security keys (REQUIRED in production) ---
# 32-byte base64 key — encrypts the account snapshot blob, addon manifest
# URLs and Trakt/Simkl tokens at rest (AES-256-GCM, versioned envelopes).
# Generate:  openssl rand -base64 32
# Rotation: move the old value to HORSE_OLD_TOKEN_SECRET (below) so existing
# records stay readable until lazily re-encrypted.
ENCRYPTION_KEY=
# Legacy/alternate key material: also derives the fallback encryption key
# (k0) when ENCRYPTION_KEY is not set. Keep it set — 32+ random chars.
HORSE_TOKEN_SECRET=
# Previous secret during rotation (optional) — decrypts old envelopes.
HORSE_OLD_TOKEN_SECRET=
# Shared secret for the scheduled-maintenance endpoint (vercel.json cron).
# The cron job sends:  Authorization: Bearer <CRON_SECRET>
# Generate:  openssl rand -hex 32
CRON_SECRET=

# --- Transactional email (password reset / email verification) ---
# Resend (resend.com) API key + verified sender. Without these, email flows
# degrade gracefully: verification is skipped, reset returns an honest
# "email not configured" error, and DEV mode logs links to the console.
RESEND_API_KEY=
MAIL_FROM="Horse <onboarding@resend.dev>"

# --- Optional: Google sign-in (only active when BOTH are set) ---
# OAuth 2.0 client (authorized redirect: https://<your-domain>/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: absolute app URL override (custom domain) ---
# Leave empty to auto-detect the deployment URL (Vercel Production/Preview
# are detected automatically). Set when emails must use a fixed domain.
APP_URL=

# --- Optional integrations (the app fails soft without each) ---
# TMDB v4 read token (themoviedb.org → Settings → API) — logos, backdrops,
# certifications, episode stills.
TMDB_ACCESS_TOKEN=
# Trakt app client id (public, PKCE — no secret by design) + optional secret.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
# Simkl app client id (+ optional secret).
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=
# OMDb / MDBList API keys — extra ratings sources.
OMDB_API_KEY=
MDBLIST_API_KEY=
