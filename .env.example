# Harbor Web — reference for environment variables.
# Local dev: copy to `.env` (gitignored) and adjust.
# Vercel: Project → Settings → Environment Variables (same keys).

# --- Database (choose ONE backend) ---
# OPTION A (recommended): Turso — durable, shared by ALL serverless instances.
#   1. Sign up at turso.com (free) → create a database
#   2. HORSE_DATABASE_URL = the database URL (libsql://....turso.io)
#   3. HORSE_DB_AUTH_TOKEN = the database auth token
#   Tables are created AUTOMATICALLY on the first request (ensure-db.ts).
HORSE_DATABASE_URL="file:/tmp/horse.db"
HORSE_DB_AUTH_TOKEN=

# Without Turso (file:/tmp on Vercel) the DB is per-instance + ephemeral:
# accounts/sync survive only while a given server instance is warm.

# --- Optional (the app fails soft without each of these) ---
# TMDB v4 read token (themoviedb.org → Settings → API) — title logos,
# enriched backdrops, certifications, episode stills.
TMDB_ACCESS_TOKEN=
# Trakt app client id (public, PKCE — no secret by design) — Trakt ratings.
TRAKT_CLIENT_ID=
# Simkl app client id — Simkl integration.
SIMKL_CLIENT_ID=
# OMDb API key — extra ratings source.
OMDB_API_KEY=
# MDBList API key — extra ratings source.
MDBLIST_API_KEY=
# Random 32+ char string — encrypts saved streaming-account tokens (vault)
# and the HORSE account session cookie.
HORSE_TOKEN_SECRET=
