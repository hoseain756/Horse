# Horse — reference for environment variables.
# Local dev: copy to `.env` (gitignored) and adjust.
# Vercel: Project → Settings → Environment Variables (set for Production AND Preview).

# --- Database: Supabase Postgres (durable backend for accounts + sync) ---
# Plain Postgres only — no Supabase Auth, no client-side Supabase SDK.
# Placeholders ONLY: copy this file to .env.local and paste your own values
# from Supabase → Project Settings → Database → Connection string.
#
#   POSTGRES_URL             → TRANSACTION pooler, port 6543 — used by the
#                              running app (pg adapter; no named prepared
#                              statements, safe behind PgBouncer).
#   POSTGRES_URL_NON_POOLING → session pooler / direct, port 5432 — used ONLY
#                              by migrations (prisma migrate deploy in the
#                              build step) via schema directUrl. Never at
#                              request time.
# Example shape (replace PROJECT_REF and YOUR_PASSWORD):
#   postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"
# RLS: every table in schema public is ENABLE ROW LEVEL SECURITY (deny-all
# for anon/authenticated) — applied by the initial migration; the app only
# reads/writes through this server-side connection, scoped by user id.

# --- Security keys (REQUIRED in production) ---
# 32-byte base64 key — encrypts the account snapshot blob, addon manifest
# URLs and Trakt/Simkl tokens at rest (AES-256-GCM, versioned envelopes).
# Generate:  openssl rand -base64 32
# Rotation: move the old value to HORSE_OLD_TOKEN_SECRET (below) so existing
# records stay readable until lazily re-encrypted.
ENCRYPTION_KEY=
# Legacy/alternate key material: also derives the fallback encryption key
# (k0) when ENCRYPTION_KEY is not set. Keep it set — 32+ random chars.
HORSE_TOKEN_SECRET=
# Previous secret during rotation (optional) — decrypts old envelopes.
HORSE_OLD_TOKEN_SECRET=
# Shared secret for the scheduled-maintenance endpoint (vercel.json cron).
# The cron job sends:  Authorization: Bearer <CRON_SECRET>
# Generate:  openssl rand -hex 32
CRON_SECRET=

# --- Transactional email (password reset / email verification) ---
# Resend (resend.com) API key + verified sender. Without these, email flows
# degrade gracefully: verification is skipped, reset returns an honest
# "email not configured" error, and DEV mode logs links to the console.
RESEND_API_KEY=
MAIL_FROM="Horse <onboarding@resend.dev>"

# --- Optional: Google sign-in (only active when BOTH are set) ---
# OAuth 2.0 client (authorized redirect: https://<your-domain>/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: absolute app URL override (custom domain) ---
# Leave empty to auto-detect the deployment URL (Vercel Production/Preview
# are detected automatically). Set when emails must use a fixed domain.
APP_URL=

# --- Optional: external torrent/stream engine (self-hosted) ---
# Horse is a neutral client: torrent streams come from the USER's own addons.
# A BitTorrent engine is a long-running process and can NEVER run inside
# Vercel serverless functions — without an engine, torrent streams show an
# honest "unplayable here" state (direct HTTP + debrid playback are unaffected).
# Self-host the ready-made engine from this repo (see deploy/README.md for
# Docker / docker-compose / Render one-click + full Vercel wiring steps):
# mini-services/torrent-service (VPS/Docker/PaaS), then point Horse at it.
# Capabilities (/api/media/capabilities) then report torrent:"external" and
# torrent streams play through your engine.
#
#   ENGINE_URL        engine base, e.g. https://torrent.example.com
#                     - JSON calls (health/prepare/status/codec/remove) are
#                       relayed server-side through /api/engine/*
#                     - media (/stream/:key/:idx, /remux/...) is fetched DIRECTLY
#                       by the browser → the host must be publicly reachable
#                       (or same-domain behind a reverse proxy)
#   ENGINE_PUBLIC_URL optional separate public base for browser-direct media
#                     (defaults to ENGINE_URL)
#   ENGINE_API_KEY    shared secret (16–200 chars, e.g. openssl rand -hex 32).
#                     Set it on BOTH the app and the engine. JSON relays attach
#                     Authorization: Bearer <key> server-side; the browser gets a
#                     short-lived HMAC token (?k=exp.sig) per media request —
#                     the key itself never reaches the client. Leave empty ONLY
#                     if the engine is protected at the network level.
ENGINE_URL=
ENGINE_PUBLIC_URL=
ENGINE_API_KEY=

# --- Optional integrations (the app fails soft without each) ---
# TMDB v4 read token (themoviedb.org → Settings → API) — logos, backdrops,
# certifications, episode stills.
TMDB_ACCESS_TOKEN=
# Trakt app client id (public, PKCE — no secret by design) + optional secret.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
# Simkl app client id (+ optional secret).
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=
# OMDb / MDBList API keys — extra ratings sources.
OMDB_API_KEY=
MDBLIST_API_KEY=
